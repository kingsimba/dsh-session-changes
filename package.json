{
  "name": "dsh-session-changes",
  "version": "0.16.0",
  "packageManager": "pnpm@10.33.0",
  "description": "An always-available Changes page for the DeepSeek Harness Web GUI: every file this Session changed, with the selected file's side-by-side pre-image comparison beside the list and per-change accept/revert.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json",
    "docs/screenshot.png"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "test:isolated": "node --test test/",
    "verify": "pnpm run format:check && pnpm run build:check && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsimba/dsh-session-changes.git"
  },
  "homepage": "https://github.com/kingsimba/dsh-session-changes#readme",
  "bugs": {
    "url": "https://github.com/kingsimba/dsh-session-changes/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "diff",
    "session",
    "changes",
    "sidebar"
  ],
  "author": "kingsimba",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "rollup": "^4.0.0"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0",
    "node": ">=22.8.0"
  },
  "license": "MIT"
}
